@startuml
title Sequencia - Ativar modo principal e alternar A/D

actor Usuario
participant "HotkeyListener" as Hotkeys
participant "AccessibilityWatcher" as Watcher
participant "KeyboardController" as Keyboard
participant "BeepService" as Beep
participant "pynput.mouse.Listener\n<<external>>" as Mouse
participant "Thread\n<<hold_refresh>>" as Refresh
participant "threading.Timer\n<<external>>" as Timer
participant "time" as TimeLib
participant "random.uniform" as Random

Usuario -> Hotkeys : pressiona F8
Hotkeys -> Hotkeys : _handle_press(F8)
Hotkeys -> Hotkeys : _can_trigger("main")
Hotkeys -> Watcher : toggle_main_mode()
activate Watcher
Watcher -> Watcher : _activate_main_mode()
Watcher -> Keyboard : press_forward()

alt side_movement_enabled
    Watcher -> Watcher : _press_side_hold_key("d")
    Watcher -> Keyboard : release_side_keys()
    Watcher -> Keyboard : press_key("d")
    Watcher -> Watcher : _schedule_next_side_switch()
    Watcher -> Random : uniform(0.5, 1.0)
end

Watcher -> Beep : activated()
deactivate Watcher

loop enquanto main_mode estiver ativo
    Refresh -> Watcher : _hold_refresh_loop()
    activate Watcher
    Watcher -> Keyboard : press_forward()
    Watcher -> Watcher : _refresh_side_hold()
    Watcher -> Keyboard : press_key(current_side_hold_key)
    Watcher -> Watcher : _switch_side_when_due()
    Watcher -> TimeLib : monotonic()

    alt intervalo lateral vencido
        Watcher -> Watcher : _get_next_side_key(current_side_hold_key)
        Watcher -> Watcher : _press_side_hold_key(next_side_key)
        Watcher -> Keyboard : release_side_keys()
        Watcher -> Keyboard : press_key(next_side_key)
        Watcher -> Watcher : _schedule_next_side_switch()
        Watcher -> Random : uniform(0.5, 1.0)
    else aguardando proximo intervalo
        Watcher --> Refresh : mantem tecla lateral atual
    end

    deactivate Watcher
end

Usuario -> Mouse : clica
Mouse -> Watcher : handle_click(x, y, button, pressed=True)
activate Watcher
Watcher -> Watcher : _start_click_effect()
Watcher -> Keyboard : release_forward()
Watcher -> Keyboard : release_side_keys()
Watcher -> Keyboard : press_effect()
Watcher -> Timer : Timer(0.8,\n_finish_click_effect,\nprevious_side_key)
Watcher -> Timer : start()
deactivate Watcher

... apos 0.8s ...

Timer -> Watcher : _finish_click_effect(previous_side_key)
activate Watcher
Watcher -> Keyboard : release_effect()
Watcher -> Keyboard : press_forward()
Watcher -> Watcher : _restore_side_movement(previous_side_key)
Watcher -> Keyboard : release_side_keys()
Watcher -> Keyboard : press_key(next_side_key)
Watcher -> Watcher : _schedule_next_side_switch()
deactivate Watcher

note right of Watcher
A alternancia lateral ocorre
automaticamente entre 0.5s e 1.0s.
O clique pausa W/A/D e segura CTRL por 0.8s.
end note

@enduml
