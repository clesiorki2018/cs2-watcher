#
# Copie este arquivo para .env e ajuste os valores locais.
# O arquivo .env real nao deve ser versionado.

# Caminhos locais
CS2_WATCHER_PROJECT_DIR=/caminho/para/cs2
CS2_WATCHER_VENV_DIR=/caminho/para/cs2/.venvcs2
CS2_WATCHER_PYTHON_BIN=/caminho/para/cs2/.venvcs2/bin/python
CS2_WATCHER_USE_SUDO=1
CS2_WATCHER_SUDO_BIN=sudo

# Hotkeys
CS2_HOTKEY_MAIN_MODE=f8
CS2_HOTKEY_SIDE_MODE=f7
CS2_HOTKEY_EXIT=esc

# Teclas usadas pelo watcher
CS2_HOLD_KEY_FORWARD=w
CS2_HOLD_KEY_RIGHT=d
CS2_HOLD_KEY_LEFT=a
CS2_EFFECT_KEY=ctrl

# Tempos em segundos
CS2_ACTION_DURATION=0.70
CS2_CLICK_DEBOUNCE=0.10
CS2_HOLD_REFRESH_INTERVAL=0.10
CS2_HOTKEY_DEBOUNCE=0.30
